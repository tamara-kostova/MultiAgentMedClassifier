# Copy this file to .env and fill in your credentials.
# The .env file is git-ignored — never commit it.

# HuggingFace token (required for the gated MedGemma model).
# 1. Accept the terms of use at https://huggingface.co/google/medgemma-1.5-4b-it
# 2. Generate a read token at https://huggingface.co/settings/tokens
# 3. Paste it below.
HF_TOKEN=hf_YOUR_TOKEN_HERE

# Checkpoint source (optional).
# hf    — (default) auto-download binary_tumor and multiclass_tumor checkpoints
#          from HF Hub the first time they are needed if not present locally.
# local — use only local files; fall back to ImageNet weights / zero-shot if absent.
#CHECKPOINT_SOURCE=hf
