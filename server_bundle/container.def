Bootstrap: docker
From: nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04

# Singularity image for the MultiAgentMedClassifier evaluation runs.
#
# Build (remote builder — no root needed):
#     singularity build --remote container.sif container.def
# Build (local, needs root/fakeroot):
#     sudo singularity build container.sif container.def
#
# The image contains ONLY the software environment. Code, data, model weights and
# checkpoints stay outside on the filesystem and are bind-mounted at run time, so
# nothing has to be rebuilt if a script or a dataset changes.
#
# CUDA: base image is CUDA 12.6.3 + cuDNN, and torch is the +cu126 build.
# Python: Ubuntu 24.04 ships Python 3.12 (3.12 is required by upstream SAM3).
#
# The package list is written inline below instead of via a %files section, because
# the Sylabs remote builder only receives this definition file — it has no access to
# files next to it. server_bundle/requirements-server.txt holds the same pins for
# local use; keep the two in sync if either changes.

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-venv \
        python3.12-dev \
        ca-certificates \
        libglib2.0-0 \
        libgomp1
    rm -rf /var/lib/apt/lists/*

    # Ubuntu 24.04's system pip is PEP-668 managed, so install into a venv.
    python3.12 -m venv /opt/venv
    # setuptools must stay <81: upstream SAM3's sam3/model_builder.py does
    # `import pkg_resources`, which setuptools removed in 81. With a newer
    # setuptools the SAM3 import fails and segmentation is silently skipped.
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip wheel "setuptools<81"

    # Pinned to the environment that produced the existing result JSONLs, so the
    # server reproduces the same numbers. Mirror of requirements-server.txt.
    cat > /opt/requirements-server.txt <<'REQEOF'
transformers==5.3.0
accelerate==1.13.0
huggingface_hub==1.7.2
tokenizers==0.22.2
safetensors==0.7.0
bitsandbytes==0.49.2
setuptools<81
pycocotools==2.0.11
open_clip_torch==3.3.0
timm==1.0.25
einops==0.8.2
ftfy==6.1.1
regex==2026.2.28
iopath==0.1.10
tqdm==4.67.3
typing_extensions==4.15.0
numpy==1.26.4
langgraph==1.1.3
langchain-core==1.2.20
pillow==12.1.1
opencv-python-headless==4.11.0.86
scipy==1.15.3
scikit-learn==1.8.0
pandas==3.0.1
matplotlib==3.10.8
seaborn==0.13.2
tabulate==0.10.0
fhir.resources==8.2.0
python-dotenv==1.2.2
REQEOF

    # CUDA 12.6 build of torch, pinned to the versions that produced the existing results.
    /opt/venv/bin/pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu126 \
        torch==2.10.0+cu126 \
        torchvision==0.25.0+cu126

    /opt/venv/bin/pip install --no-cache-dir -r /opt/requirements-server.txt

    # Fail the build here rather than at 3 a.m. on the GPU node.
    /opt/venv/bin/python - <<'PYEOF'
import cv2, langgraph, numpy, open_clip, pandas, sklearn, torch, transformers
print("torch        ", torch.__version__, "| cuda build", torch.version.cuda)
print("transformers ", transformers.__version__)
print("open_clip    ", open_clip.__version__)
print("numpy        ", numpy.__version__)
print("pandas       ", pandas.__version__)
print("opencv       ", cv2.__version__)
import bitsandbytes  # noqa: F401  (import must succeed; CUDA check happens at run time)
print("bitsandbytes  import OK")
PYEOF

%environment
    export PATH=/opt/venv/bin:$PATH
    # $HOME is bind-mounted by Singularity; without this, host ~/.local packages
    # can shadow the container's pinned versions (this bit us with numpy 2.x).
    export PYTHONNOUSERSITE=1
    export PYTHONUNBUFFERED=1
    export TOKENIZERS_PARALLELISM=false

%runscript
    exec /opt/venv/bin/python "$@"

%test
    /opt/venv/bin/python -c "import torch; print('torch', torch.__version__, 'cuda_available', torch.cuda.is_available())"

%labels
    Author       Tamara Kostova
    Project      MultiAgentMedClassifier
    Description  Multi-agent neuroimaging classification (MedGemma + CNN + SAM3 + BiomedCLIP)
    CUDA         12.6.3
    Python       3.12
    Torch        2.10.0+cu126

%help
    Software environment for the MultiAgentMedClassifier evaluation runs.

    Everything is driven by the numbered scripts in server_bundle/ — see
    server_bundle/README_SERVER.md. Quick check that the GPU is visible:

        singularity exec --nv container.sif python -c \
            "import torch; print(torch.cuda.get_device_name(0))"
