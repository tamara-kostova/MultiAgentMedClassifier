# ─────────────────────────────────────────────────────────────────────────────
#  The only file you may need to edit on the server.
#  Every path is relative to the project root (the directory that contains
#  run_pipeline.py). Absolute paths also work.
#
#  Each value can also be overridden for a single run without editing this file:
#      MAX_SAMPLES=300 bash server_bundle/01_forest_stroke.sh
# ─────────────────────────────────────────────────────────────────────────────

# Singularity image built from server_bundle/container.def
SIF="${SIF:-container.sif}"

# Dataset directories (<dir>/<class>/... image files)
DATA_BR35H="${DATA_BR35H:-data/Br35H}"
DATA_FIGSHARE="${DATA_FIGSHARE:-data/figshare}"
DATA_MS="${DATA_MS:-data/sclerosis/MS}"
DATA_STROKE="${DATA_STROKE:-data/stroke/Brain_Stroke_CT_Dataset}"

# Images per run, sampled class-balanced (500 → e.g. 250/250 binary, 125x4 for MS).
# Lower this if a run must fit a shorter time slot; runs are resumable, so a later
# run with a higher number simply continues.
MAX_SAMPLES="${MAX_SAMPLES:-500}"

# Set to 1 if MedGemma does not fit in GPU memory (needed below ~12 GB VRAM).
# 0 = bfloat16 (faster, what the existing results used).
LOAD_4BIT="${LOAD_4BIT:-0}"

# HuggingFace model cache shipped with the bundle. Runs are fully offline.
HF_CACHE_DIR="${HF_CACHE_DIR:-hf_cache}"

# ── v2 campaign (RERUN_PLAN.md) ──────────────────────────────────────────────
# Every v2 run writes here. Never point a run at outputs/eval/ directly: those
# names hold the published results.
V2_OUT="${V2_OUT:-outputs/eval/v2}"

# Images per step in 10_smoke (every step in steps.sh is run on this many images
# before any long run starts).
SMOKE_N="${SMOKE_N:-2}"

# Homogeneous-sampling forest (H1) and role-diverse sampled forest (H2).
FOREST_TEMPERATURE="${FOREST_TEMPERATURE:-0.7}"
FOREST_SEED="${FOREST_SEED:-0}"

# ── OSC GPU cluster, own account (SELF_RUN.md) ───────────────────────────────
# Used by sync.sh on the local machine. CLUSTER_HOST is an ssh alias or user@host;
# CLUSTER_DIR is relative to the remote home unless absolute.
CLUSTER_HOST="${CLUSTER_HOST:-osc-gpu}"
CLUSTER_DIR="${CLUSTER_DIR:-maclf}"

# Used by submit.sh on the login node. From scripts/cluster_info.sh (2026-10-08):
# openlab-slurm has one GPU node (gpgpu01, 4 GPUs: gres gpu:standard:3 + gpu:dedicated:1,
# 96 CPUs, 1 TB RAM). openlab-queue is the default partition, 24 h limit. The openlab QOS
# has GrpTRES gres/gpu=1, i.e. one GPU at a time for the group, so put several steps on
# one GPU with `submit.sh pair` (~14 GB VRAM each) rather than one job per step.
SLURM_PARTITION="${SLURM_PARTITION:-openlab-queue}"
SLURM_ACCOUNT="${SLURM_ACCOUNT:-}"
SLURM_GRES="${SLURM_GRES:-gpu:1}"
SLURM_TIME="${SLURM_TIME:-24:00:00}"
SLURM_CPUS="${SLURM_CPUS:-8}"
SLURM_MEM="${SLURM_MEM:-96G}"
SLURM_EXTRA="${SLURM_EXTRA:-}"
